+/**
+ * @brief  F-09: one gyroscope sample (GX, GY, GZ, little-endian int16).
+ * @param  p_raw  6 bytes.
+ */
+static void itl_gyro (uint8_t const * p_raw)
+{
+    float const gx = (float)itl_s16(&p_raw[0]) / ITL_LSB_PER_DPS;
+    float const gy = (float)itl_s16(&p_raw[2]) / ITL_LSB_PER_DPS;
+    float const gz = (float)itl_s16(&p_raw[4]) / ITL_LSB_PER_DPS;
+    float const gxy = fmaxf(fabsf(gx), fabsf(gy));
+
+    g_win_gz    = fmaxf(g_win_gz, fabsf(gz));
+    g_win_gxy   = fmaxf(g_win_gxy, gxy);
+    g_win_angle += gz / ITL_GYRO_HZ;
+}
