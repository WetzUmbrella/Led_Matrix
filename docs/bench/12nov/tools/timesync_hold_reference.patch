+/**
+ * @brief  Hold the reference: whether the filter's new smallest offset
+ *         replaces the estimate. A fall, or a rise within
+ *         TIMESYNC_RISE_FLOOR_US plus TIMESYNC_RISE_US_PER_S since the
+ *         estimate's sample (jitter and drift), is taken at once. A faster rise is network delay and is held, until
+ *         it has lasted TIMESYNC_HOLD_MAX_US (a lasting path change).
+ * @param  cand_offset  Smallest (t_l - t_p) in the window now.
+ * @param  cand_ref     t_l of that sample.
+ * @param  t_l          Local receive time of the newest sample.
+ * @return true when the candidate becomes the estimate.
+ */
+static bool estimate_take (int64_t cand_offset, int64_t cand_ref, int64_t t_l)
+{
+    bool b_take = true;
+
+    if (g_writer.b_est_valid)
+    {
+        int32_t const drift =
+            g_writer.b_drift_valid ? g_writer.drift_ppb : 0;
+        int64_t const projected =
+            g_writer.est_offset +
+            timesync_scale_ppb(cand_ref - g_writer.est_ref, drift);
+        int64_t const since   = cand_ref - g_writer.est_ref;
+        int64_t const allowed =
+            TIMESYNC_RISE_FLOOR_US +
+            ((since > 0) ? ((since * TIMESYNC_RISE_US_PER_S) /
+                            (int64_t)TIMESYNC_US_PER_S)
+                         : 0);
+
+        if ((cand_offset - projected) <= allowed)
+        {
+            g_writer.b_holding = false;
+        }
+        else if (!g_writer.b_holding)
+        {
+            g_writer.b_holding  = true;
+            g_writer.hold_since = t_l;
+            b_take              = false;
+        }
+        else if ((t_l - g_writer.hold_since) < TIMESYNC_HOLD_MAX_US)
+        {
+            b_take = false;
+        }
+        else
+        {
+            g_writer.b_holding = false; /* Lasted: a real change. */
+        }
+    }
+
+    return b_take;
+}
