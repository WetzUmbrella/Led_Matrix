+/**
+ * @brief  The corrected-clock error after one more beacon and its ticks: a
+ *         beacon every 100 ms, six 60 Hz ticks, the tile clock 5 s ahead.
+ * @param  idx     Beacon number.
+ * @param  delay   Its network delay, microseconds.
+ * @return |corrected - true Pico time| just before the next beacon, us.
+ */
+static int64_t hold_step (uint32_t idx, int64_t delay)
+{
+    timesync_reader_t reader = {0};
+    int64_t const     t_p    = READY_START_US + ((int64_t)idx * BEACON_PERIOD_US);
+    int64_t const     t_l    = t_p + HOLD_AHEAD_US + delay;
+
+    timesync_add_sample(t_p, t_l);
+
+    for (uint32_t tick = 0u; tick < HOLD_TICKS; tick++)
+    {
+        int64_t const now = t_l + ((int64_t)tick * HOLD_TICK_US);
+
+        timesync_test_set_now_us(now);
+        timesync_tick(now);
+    }
+
+    int64_t const now = t_l + BEACON_PERIOD_US - 1;
+
+    timesync_test_set_now_us(now);
+
+    int64_t const err = timesync_now_corrected(&reader) - (now - HOLD_AHEAD_US);
+
+    return (err < 0) ? -err : err;
+}
