+/**
+ * @brief  Hold the reference (decided with Cheston 12 Nov 2026, Matrix
+ *         router): a 6 s congestion period that ramps the beacon delay to
+ *         900 ms and back keeps the corrected clock within 20 ms (it was
+ *         658 ms off and over 50 ms for 38 s); a lasting 300 ms change of
+ *         the delay is taken after the 10 s hold, so the estimate follows a
+ *         real change.
+ * @return true when every check passed.
+ */
+bool test_timesync_hold (void)
+{
+    bool    b_ok   = true;
+    int64_t worst  = 0;
+    int64_t offset = 0;
+    int64_t ref    = 0;
+
+    timesync_init();
+
+    for (uint32_t idx = 0u; idx < HOLD_BEACONS; idx++)
+    {
+        /* Congestion from beacon 100 to 159: up 30 steps, down 30. */
+        int64_t delay = READY_DELAY_US;
+
+        if ((idx >= HOLD_JAM_FIRST) && (idx < (HOLD_JAM_FIRST + 60u)))
+        {
+            uint32_t const step = idx - HOLD_JAM_FIRST;
+            uint32_t const up   = (step < 30u) ? step : (59u - step);
+
+            delay += (HOLD_JAM_PEAK_US * (int64_t)up) / 30;
+        }
+
+        int64_t const err = hold_step(idx, delay);
+
+        worst = ((idx > TIMESYNC_WINDOW) && (err > worst)) ? err : worst;
+    }
+
+    printf("    900 ms congestion ramp: worst error %" PRId64 " us\n", worst);
+    b_ok = (test_main_check(worst < HOLD_MAX_ERR_US, __LINE__)) && b_ok;
+    b_ok = (test_main_check(0u == timesync_reseed_count(), __LINE__)) && b_ok;
+
+    /* A lasting 300 ms rise: held at first, taken after 10 s. */
+    uint32_t idx = HOLD_BEACONS;
+
+    for (uint32_t step = 0u; step < 20u; step++, idx++)
+    {
+        (void)hold_step(idx, READY_DELAY_US + HOLD_LASTING_US); /* Err. */
+    }
+
+    b_ok = (test_main_check((timesync_filter_estimate(&offset, &ref)) &&
+                                (offset < (HOLD_AHEAD_US + HOLD_LASTING_US)),
+                            __LINE__)) &&
+           b_ok;
+
+    for (uint32_t step = 0u; step < 100u; step++, idx++)
+    {
+        (void)hold_step(idx, READY_DELAY_US + HOLD_LASTING_US); /* Err. */
+    }
+
+    b_ok = (test_main_check((timesync_filter_estimate(&offset, &ref)) &&
+                                (offset == (HOLD_AHEAD_US + READY_DELAY_US +
+                                            HOLD_LASTING_US)),
+                            __LINE__)) &&
+           b_ok;
+    printf("    lasting 300 ms rise: estimate %" PRId64 " us after 12 s\n",
+           offset - HOLD_AHEAD_US);
+    timesync_init();
+
+    return b_ok;
+}
