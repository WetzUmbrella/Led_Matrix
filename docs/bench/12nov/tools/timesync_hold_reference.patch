+/** The off samples of one run must agree with the run's first within this
+ *  much (offset t_l - t_p): another Pico clock gives a steady offset, while
+ *  congestion wanders (tens of ms per beacon), so congestion never
+ *  re-seeds and the held reference rides it out (12 Nov 2026). */
+#define TIMESYNC_RESEED_AGREE_US INT64_C(20000)
+
+/** Hold the reference (decided with Cheston 12 Nov 2026): the filter's new
+ *  smallest offset may rise above the current estimate by at most this many
+ *  microseconds per second since the estimate's sample. A crystal drifts a
+ *  few tens of us per second at most, so a faster rise is network delay
+ *  (every beacon in the 1.6 s window late) and the estimate is held. */
+#define TIMESYNC_RISE_US_PER_S INT64_C(1000)
+
+/** Largest drift taken from the window, ppb: TIMESYNC_RISE_US_PER_S as a
+ *  rate (1,000 us per 10^6 us = 10^6 ppb); a faster slope is held. */
+#define TIMESYNC_DRIFT_MAX_PPB (TIMESYNC_RISE_US_PER_S * INT64_C(1000))
+
+/** A rise up to this much is always taken: ordinary WiFi jitter of the
+ *  window minimum (T-B4-02 absorbs a 2 ms step in 20 ticks). Congestion
+ *  rises by tens to hundreds of ms. */
+#define TIMESYNC_RISE_FLOOR_US INT64_C(5000)
+
+/** A rise held this long is taken as real: the network path changed. */
+#define TIMESYNC_HOLD_MAX_US INT64_C(10000000)
+
 /** Snapshot flag: a published set was copied at least once. */
 #define TIMESYNC_SNAP_VALID 0x1u
 
