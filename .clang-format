# Barr-C:2018 layout for SE15 C files (docs/coding_standard.md).
# Pinned to clang-format 18.1.8 (pip install clang-format==18.1.8), the
# version CI runs, because other versions format some constructs differently.
# Rule numbers are Barr-C:2018 sections.
Language: Cpp
BasedOnStyle: LLVM

# 1.2.a lines at most 80 characters.
ColumnLimit: 80

# 3.4.a indent in multiples of 4; 3.5.a no tab characters.
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
TabWidth: 4

# 1.3.b each brace on its own line (Allman).
BreakBeforeBraces: Allman

# 1.3.a braces around every if, else, for, while and do body.
InsertBraces: true
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# 3.4.b case labels aligned, case contents indented once from the label.
IndentCaseLabels: true
IndentCaseBlocks: false

# 3.2.a, 3.2.b, 3.2.c alignment of declarations, members and assignments.
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true

# 3.1.e white space on each side of * and & in declarations.
PointerAlignment: Middle

# 3.1.a one space after if, while, for, switch; 3.1.j one space between the
# function name and "(" in declarations and definitions only, none in calls.
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterForeachMacros: true
  AfterFunctionDeclarationName: true
  AfterFunctionDefinitionName: true
  AfterIfMacros: true
  AfterOverloadedOperator: false
  BeforeNonEmptyParentheses: false

# 3.1.i no spaces inside parentheses.
SpacesInParentheses: false

# 3.2.d "#" at the start of the line.
IndentPPDirectives: None

# Includes are ordered by hand (Barr-C 4.3.b section order); comments are
# wrapped by hand, so tables in comments keep their layout.
SortIncludes: Never
ReflowComments: false

# 3.3.b blank lines: keep at most one.
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false
